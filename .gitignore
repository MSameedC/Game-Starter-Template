# ================================
# Unity .gitignore
# ================================

# Unity generated directories & cache
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity generated logs & crash reports
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# UI Toolkit generated schema files
UIElementsSchema/

# Blender backup files
*.blend1
*.blend1.meta

# Builds & Exports
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# ================================
# IDEs, Solutions & Editors
# ================================

# Visual Studio & modern Solution files (.slnx)
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Zed Editor specific files
.zed/
/[Aa]ssets/FixZedArgs.cs
/[Aa]ssets/FixZedArgs.cs.meta

# ================================
# OS Generated Files
# ================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

